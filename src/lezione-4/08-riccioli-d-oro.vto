    </svg>
  </div>
  <label class="slider"><span>☀️ Vicino</span><input type="range" min="0" max="100" value="0" aria-label="Allontana il pianeta dal Sole"><span>🥶 Lontano</span></label>
  <output class="caption"></output>
  <style>
    @scope {
      .world { translate: calc(var(--t) * 250px) 0; }
