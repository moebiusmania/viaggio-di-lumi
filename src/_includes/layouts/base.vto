<!doctype html>
<html lang="{{ lang }}" data-lesson="{{ lesson || 0 }}" data-index="{{ index ?? -1 }}"{{ if offline }} data-offline{{ /if }}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }} · {{ ui.app.name }}</title>
  <meta name="description" content="{{ ui.app.description |> escape }}">
  <meta name="theme-color" content="#c49a6c">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ ui.app.name |> escape }}">
  <meta property="og:title" content="{{ title |> escape }} · {{ ui.app.name |> escape }}">
  <meta property="og:description" content="{{ ui.app.description |> escape }}">
  <meta property="og:url" content="{{ url |> url(true) }}">
  <meta property="og:locale" content="{{ ui.app.locale |> replace('-', '_') }}">
  <meta property="og:image" content="{{ '/assets/images/social.png' |> url(true) }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ui.app.imageAlt |> escape }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="{{ home }}manifest.webmanifest">
  <meta name="apple-mobile-web-app-title" content="{{ ui.app.shortName |> escape }}">
  <link rel="preload" href="/assets/fonts/caveat-brush-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/patrick-hand-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/textures/kraft.webp" as="image" type="image/webp">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>
    // Decide which way the page turns before the first paint (forward or back).
    (() => {
      const html = document.documentElement;
      const index = Number(html.dataset.index);
      const last = Number(sessionStorage.getItem("lumi-index") ?? -1);
      const dir = last > index ? "back" : "forward";
      html.dataset.dir = dir;
      sessionStorage.setItem("lumi-index", String(index));
      if (!("onpagereveal" in window)) html.classList.add("no-vt");
      addEventListener("pagereveal", (e) => e.viewTransition?.types.add(dir));
    })();
  </script>
  <script type="application/json" id="lumi-text">{{ jsText }}</script>
  <script type="module" src="/assets/js/app.js"></script>
</head>
<body>
  <div class="desk" aria-hidden="true"></div>
  <div class="lamp" aria-hidden="true"></div>

  <header class="topbar">
    <a class="brand" href="{{ home }}" aria-label="{{ ui.topbar.home |> escape }}">
      <svg class="brand-lumi" viewBox="-4 -4 108 108" aria-hidden="true"><use href="#lumi"/></svg>
      <span>{{ ui.topbar.brand |> fill({ name: `<b>${ui.app.shortName}</b>` }) }}</span>
    </a>
    {{ if lesson }}
    <p class="topbar-lesson"><span class="pill">{{ ui.topbar.lesson |> fill({ n: lesson }) }}</span> {{ lessonInfo.title }}</p>
    {{ /if }}
    <div class="topbar-actions">
      <span class="star-count" title="{{ ui.topbar.stars |> escape }}">
        <svg viewBox="-4 -4 108 108" aria-hidden="true"><use href="#star"/></svg>
        <b data-star-count>0</b><span class="sr-only"> {{ ui.topbar.starsCount }}</span>
      </span>
      <button class="icon-btn" type="button" data-sound aria-pressed="true" title="{{ ui.js.soundOn |> escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-sound"/></svg><span class="sr-only">{{ ui.topbar.sound }}</span>
      </button>
      <button class="icon-btn" type="button" data-read aria-pressed="false" title="{{ ui.topbar.read |> escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-read"/></svg><span class="sr-only">{{ ui.topbar.read }}</span>
      </button>
      <button class="icon-btn toc-btn" type="button" data-toc aria-haspopup="dialog" title="{{ ui.topbar.tocTitle |> escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-menu"/></svg><span>{{ ui.topbar.toc }}</span>
      </button>
    </div>
  </header>

  {{ content }}

  {{ include "partials/toc.vto" }}
  {{ include "partials/sprite.vto" }}
</body>
</html>
