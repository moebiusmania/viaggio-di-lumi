---
layout: layouts/base.vto
---
<main class="home">
  <section class="hero">
    <div class="hero-text">
      <p class="kicker">{{ kicker }}</p>
      <h1>{{ heading |> fill({ name: `<span>${ui.app.shortName}</span>` }) }}</h1>
      <p class="hero-sub">{{ subtitle }}</p>
      <div class="lumi-talk">
        <svg class="lumi" viewBox="-4 -4 108 108" aria-hidden="true"><use href="#lumi"/></svg>
        <div class="bubble" data-speak>
          {{ content }}
        </div>
      </div>
      <div class="btn-row hero-actions">
        <a class="btn big" href="{{ toc[0].url }}">{{ start }}</a>
        <a class="btn big sky" href="#" data-continue hidden>{{ resume }}</a>
      </div>
    </div>

    <div class="hero-art scene" aria-hidden="true">
      <svg viewBox="0 0 400 320">
        <path id="journey" d="M58 66 C 130 10, 170 190, 120 230 S 190 330, 250 250 S 250 90, 300 90 S 380 180, 335 250" fill="none" stroke="#f6f0e3" stroke-opacity=".75" stroke-width="3" stroke-dasharray="1 10" stroke-linecap="round"/>

        <g class="burst">
          <path d="M58 26 L66 50 L90 38 L78 60 L102 70 L78 78 L90 102 L66 88 L58 112 L50 88 L26 100 L38 78 L14 70 L38 60 L26 38 L50 50 Z" fill="#efbd38" stroke="#2c1d11" stroke-width="4" stroke-linejoin="round"/>
          <circle cx="58" cy="69" r="16" fill="#f8ecc0" stroke="#2c1d11" stroke-width="3"/>
        </g>
        <text class="label" x="58" y="138" text-anchor="middle" font-size="16">{{ art[0] }}</text>

        <g class="galaxy" transform="translate(120 225)">
          <g class="spin"><use href="#galaxy" x="-46" y="-46" width="92" height="92"/></g>
        </g>
        <text class="label" x="120" y="290" text-anchor="middle" font-size="16">{{ art[1] }}</text>

        <g class="sun">
          <g class="spin">
            <circle cx="300" cy="90" r="46" fill="none" stroke="#efbd38" stroke-width="10" stroke-dasharray="6 12" opacity=".8"/>
          </g>
          <circle cx="300" cy="90" r="34" fill="#efbd38" stroke="#2c1d11" stroke-width="4"/>
          <use href="#face" x="282" y="84" width="36" height="22"/>
        </g>
        <text class="label" x="300" y="158" text-anchor="middle" font-size="16">{{ art[2] }}</text>

        <g class="earth">
          <circle cx="335" cy="250" r="32" fill="#4a8fc0" stroke="#2c1d11" stroke-width="4"/>
          <path d="M312 236 q10 -12 22 -4 q6 10 -4 16 q-10 2 -18 -12z M340 262 q12 -8 20 2 q-4 14 -16 12z M338 224 q10 -4 16 4 q-8 4 -16 -4z" fill="#5fae80" stroke="#2c1d11" stroke-width="2.5"/>
          <use href="#face" x="318" y="244" width="34" height="20"/>
        </g>
        <text class="label" x="335" y="305" text-anchor="middle" font-size="16">{{ art[3] }}</text>

        <g class="traveller">
          <use href="#lumi" x="-22" y="-22" width="44" height="44"/>
          <animateMotion dur="14s" repeatCount="indefinite" rotate="0" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
            <mpath href="#journey"/>
          </animateMotion>
        </g>
      </svg>
    </div>
  </section>

  <section class="lessons" aria-labelledby="lessons-title">
    <h2 id="lessons-title">{{ lessonsTitle }}</h2>
    <ol class="lesson-cards">
      {{ for l of toc }}
      <li style="--c: var(--l{{ l.n }}); --i: {{ l.n }}">
        <a class="lesson-card" href="{{ l.url }}">
          <span class="lesson-card-num">{{ l.n }}</span>
          <span class="lesson-card-body">
            <b>{{ l.title }}</b>
            <span>{{ l.subtitle }}</span>
            <small>{{ lessonCard |> fill({ pages: l.pages.length }) }}</small>
          </span>
          <span class="lesson-card-medal" data-medal="{{ l.n }}" title="{{ medal |> escape }}"><svg viewBox="0 0 100 130" aria-hidden="true"><use href="#medal"/></svg></span>
        </a>
      </li>
      {{ /for }}
    </ol>
  </section>

  <section class="howto" aria-labelledby="howto-title">
    <h2 id="howto-title">{{ howtoTitle }}</h2>
    <ul>
      {{ for i, item of howto }}
      <li><span class="howto-icon">{{ ["<kbd>←</kbd> <kbd>→</kbd>", '<svg viewBox="0 0 24 24"><use href="#i-tap"/></svg>', '<svg viewBox="0 0 24 24"><use href="#i-menu"/></svg>', '<svg viewBox="0 0 24 24"><use href="#i-sound"/></svg>', '<svg viewBox="-4 -4 108 108"><use href="#star"/></svg>'][i] }}</span> <span>{{ item |> md(true) }}</span></li>
      {{ /for }}
    </ul>
    <p class="grownups">{{ grownups |> md(true) }}</p>
  </section>

  {{ include "partials/credits.vto" }}

</main>
