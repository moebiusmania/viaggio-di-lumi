---
layout: layouts/base.vto
---
<main class="book" data-kind="{{ kind || 'page' }}">
  <div class="journey">
    <div class="journey-track" role="img" aria-label="{{ ui.page.journey |> fill({ n: index + 1, total }) |> escape }}">
      {{ for l of toc }}
      <span class="journey-seg" style="--c: var(--l{{ l.n }}); --n: {{ l.pages.length }}"></span>
      {{ /for }}
      <svg class="journey-rocket" style="--pos: {{ index / (total - 1) }}" viewBox="0 0 64 64" aria-hidden="true"><use href="#rocket"/></svg>
    </div>
    <p class="journey-when"><span aria-hidden="true">⏳</span> {{ when || lessonInfo.when }}</p>
  </div>

  <article class="slide">
    <div class="slide-scroll">
    <header class="slide-head">
      <p class="kicker">{{ ui.page.kicker |> fill({ lesson, page: pageNum, total: lessonTotal }) }}</p>
      <h1>{{ title }}</h1>
    </header>

    <div class="slide-body">
      {{ if kind == "cover" }}
      <div class="stage">
        <div class="cover">
          <div class="cover-text">
            <span class="lesson-no">{{ lesson }}</span>
            <div data-speak>{{ content }}</div>
            <h2>{{ ui.cover.missions }}</h2>
            <ul class="mission-list">
              {{ for i, m of missions }}<li style="--i:{{ i }}">{{ m |> md(true) }}</li>{{ /for }}
            </ul>
            <p class="time-chip">{{ ui.cover.time |> fill({ pages: lessonTotal }) }}</p>
          </div>
          {{ include scene }}
        </div>
      </div>
      {{ else }}
      {{ set talk = kind != "cert" && content.trim() }}
      {{ if talk || task || fact }}
      <div class="story">
        {{ if talk }}
        <div class="lumi-talk">
          <svg class="lumi" viewBox="-4 -4 108 108" aria-hidden="true"><use href="#lumi"/></svg>
          <div class="bubble" data-speak>
            {{ content }}
          </div>
        </div>
        {{ /if }}
        {{ if task }}<p class="task" data-speak><strong>{{ ui.page.task }}</strong> {{ task |> md(true) }}</p>{{ /if }}
        {{ if fact }}<details class="fact"><summary>{{ ui.page.fact }}</summary><p data-speak>{{ fact |> md(true) }}</p></details>{{ /if }}
      </div>
      {{ /if }}
      <div class="stage">
        {{ include scene }}
      </div>
      {{ /if }}
    </div>
    </div>
  </article>

  <nav class="pager" aria-label="{{ ui.page.pager |> escape }}">
    <a class="nav-arrow" rel="prev" href="{{ prev }}" data-dir="back">
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-left"/></svg>
      <span class="sr-only">{{ ui.page.prev }}</span>
    </a>
    <ol class="dots">
      {{ for i, p of lessonInfo.pages }}
      <li><a href="{{ p.url }}" data-url="{{ p.url |> url }}" {{ if p.url == url }}aria-current="page"{{ /if }} title="{{ p.title }}"><span class="sr-only">{{ p.title }}</span></a></li>
      {{ /for }}
    </ol>
    <a class="nav-arrow next" rel="next" href="{{ next }}" data-dir="forward">
      <span class="nav-label">{{ if pageNum == lessonTotal }}{{ if lesson < lastLesson }}{{ ui.page.nextLesson |> fill({ n: lesson + 1 }) }}{{ else }}{{ ui.page.end }}{{ /if }}{{ else }}{{ ui.page.forward }}{{ /if }}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-right"/></svg>
      <span class="sr-only">{{ ui.page.next }}</span>
    </a>
  </nav>
</main>
