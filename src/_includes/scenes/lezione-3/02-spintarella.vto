<anim-trigger target="#push-scene" done-ms="2800" data-again-text="{{ button.again |> escape }}">
  <div class="scene" id="push-scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <g class="sn">
        <circle cx="40" cy="150" r="22" fill="#d98256" stroke="#2c1d11" stroke-width="4"/>
        <use href="#face" x="26" y="146" width="28" height="17"/>
      </g>
      <circle class="flash" cx="40" cy="150" r="30" fill="#f8ecc0"/>
      <circle class="wave" cx="40" cy="150" r="60" fill="none" stroke="#93c3d9" stroke-width="10"/>
      <circle class="wave w2" cx="40" cy="150" r="60" fill="none" stroke="#e495a8" stroke-width="6"/>
      <g class="neb">
        <path d="M200 90 Q250 50 300 80 Q360 90 350 150 Q370 210 300 220 Q250 250 200 215 Q150 220 160 160 Q140 100 200 90 Z" fill="#8d9bd0" stroke="#2c1d11" stroke-width="5" stroke-linejoin="round"/>
        <path d="M225 150 q10 8 20 0 M275 150 q10 8 20 0" fill="none" stroke="#2c1d11" stroke-width="4" stroke-linecap="round"/>
      </g>
      {{ for k of [[230, 120], [290, 185], [265, 140], [310, 110]] }}
      <circle class="knot" cx="{{ k[0] }}" cy="{{ k[1] }}" r="10" fill="#efbd38"/>
      {{ /for }}
    </svg>
  </div>
  <div class="btn-row"><button class="btn big pink" type="button">{{ button.go }}</button></div>
  <style>
    @scope {
      :scope { display: flex; flex-direction: column; gap: 1rem; }
      .flash, .wave, .knot { opacity: 0; }
      .run .sn { animation: sn-go .5s ease-in forwards; }
      .run .flash { animation: flash .6s .4s ease-out; }
      .run .wave { animation: wave 1.6s .45s ease-out; transform-box: view-box !important; transform-origin: 40px 150px !important; }
      .run .w2 { animation-delay: .6s; }
      .run .neb { animation: squish 1.4s 1.2s var(--ease-spring) forwards; transform-origin: 70% 50% !important; }
      .run .knot { animation: knot .6s 2.2s var(--ease-bounce) forwards, pulse 1s 2.8s ease-in-out infinite; }
      @keyframes sn-go { 60% { scale: 1.5; } to { scale: 0; opacity: 0; } }
      @keyframes flash { 0% { opacity: 1; scale: 1; } 100% { opacity: 0; scale: 8; } }
      @keyframes wave { from { opacity: 1; scale: .3; } to { opacity: 0; scale: 6; } }
      @keyframes squish { 0% { scale: 1; } 30% { scale: .78 1.08; translate: 20px 0; } 100% { scale: .88 .94; translate: 10px 0; } }
      @keyframes knot { from { opacity: 0; scale: 0; } to { opacity: 1; scale: 1; } }
    }
  </style>
</anim-trigger>
