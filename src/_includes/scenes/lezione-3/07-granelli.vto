<order-game>
  <div class="pool">
    <button class="chip" data-i="0"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="6" fill="#a8927e"/><circle cx="30" cy="40" r="3" fill="#a8927e"/><circle cx="66" cy="62" r="4" fill="#a8927e"/></svg> {{ chips[0].name }}</button>
    <button class="chip" data-i="1"><svg viewBox="-50 -50 100 100" aria-hidden="true"><use href="#rock" x="-20" y="-20" width="40" height="40"/></svg> {{ chips[1].name }}</button>
    <button class="chip" data-i="2"><svg viewBox="-50 -50 100 100" aria-hidden="true"><use href="#rock" x="-34" y="-34" width="68" height="68"/></svg> {{ chips[2].name }} <small>{{ chips[2].note }}</small></button>
    <button class="chip" data-i="3"><svg viewBox="-50 -50 100 100" aria-hidden="true"><use href="#rock" x="-50" y="-50" width="100" height="100"/></svg> {{ chips[3].name }} <small>{{ chips[3].note }}</small></button>
    <button class="chip" data-i="4"><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="44" fill="#c78f64" stroke="#2c1d11" stroke-width="5"/><use href="#face" x="-18" y="-4" width="36" height="22"/></svg> {{ chips[4].name }}</button>
  </div>
  <ol class="slots"></ol>
  <output class="caption">{{ caption }}</output>
  <style>
    @scope {
      .chip small { display: block; font-family: var(--font-body); font-size: .75rem; }
      .chip svg { background: var(--space-1); border-radius: .6rem; }
    }
  </style>
</order-game>
