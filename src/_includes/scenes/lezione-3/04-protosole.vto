<candy-jar total="1000" sun="998">
  <div class="scene jar-scene">
    <div class="jar" aria-label="{{ jar |> escape }}"></div>
    <p class="result">{{ result |> md(true) }}</p>
  </div>
  <div class="btn-row"><button class="btn big" type="button">{{ button }}</button></div>
  <style>
    @scope {
      .jar-scene { display: grid; place-items: center; padding: 4%; }
      .jar {
        display: grid;
        grid-template-columns: repeat(40, 1fr);
        gap: 2px;
        width: 100%;
        & i {
          aspect-ratio: 1;
          border-radius: 50%;
          background: #8d9bd0;
          transition: background .4s, scale .4s var(--ease-bounce);
          &.sun { background: #efbd38; }
          &.rest { background: #dd6682; scale: 2.2; box-shadow: 0 0 0 1px #2c1d11; position: relative; z-index: 2; animation: pulse 1s ease-in-out infinite; }
        }
      }
      .result {
        position: absolute;
        inset: auto 8% 8%;
        padding: .7rem 1rem;
        border: var(--line);
        border-radius: 1rem;
        background: var(--paper);
        color: var(--ink);
        text-align: center;
        font-family: var(--font-head);
        font-size: clamp(1rem, 2.5vw, 1.4rem);
        line-height: 1.2;
        scale: 0;
        transition: scale .6s var(--ease-bounce);
      }
      :scope.revealed .result { scale: 1; }
    }
  </style>
</candy-jar>
