<div class="scene" aria-hidden="true">
  <svg viewBox="0 0 400 300">
    <use href="#galaxy" x="110" y="60" width="180" height="180" class="spin" style="animation-duration: 40s"/>
    {{ for s of [[50, 50, 30, 1], [340, 60, 38, 2], [70, 230, 34, 3], [330, 235, 28, 1], [200, 30, 22, 2]] }}
    <g class="float delay-{{ s[3] }}">
      <use href="#lumi" x="{{ s[0] - s[2] / 2 }}" y="{{ s[1] - s[2] / 2 }}" width="{{ s[2] }}" height="{{ s[2] }}"/>
    </g>
    {{ /for }}
    {{ for s of [[130, 40], [270, 270], [30, 140], [380, 150], [160, 270], [250, 20]] }}
    <use href="#star" x="{{ s[0] - 7 }}" y="{{ s[1] - 7 }}" width="14" height="14" class="twinkle"/>
    {{ /for }}
  </svg>
</div>
