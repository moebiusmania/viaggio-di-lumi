<fusion-game need="4">
  <div class="scene fusion-scene">
    <div class="star-bg" aria-hidden="true"></div>
    <div class="fusion-grid"></div>
  </div>
  <output class="caption"></output>
  <style>
    @scope {
      .fusion-scene { display: grid; place-items: center; }
      .star-bg {
        position: absolute;
        inset: 8%;
        border-radius: 50%;
        background: radial-gradient(circle, #fff7c2 0%, #ffd23f 35%, #ff8a3d 65%, transparent 72%);
        opacity: calc(.25 + var(--p) * .75);
        scale: calc(.8 + var(--p) * .25);
        filter: blur(4px);
        transition: opacity .6s, scale .6s var(--ease-bounce);
        animation: pulse 2.4s ease-in-out infinite;
      }
      .fusion-grid {
        position: relative;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: clamp(.6rem, 3vw, 1.6rem);
      }
      .h-atom {
        width: clamp(3rem, 8vw, 4.4rem);
        aspect-ratio: 1;
        border-radius: 50%;
        border: 4px solid var(--ink);
        background: radial-gradient(circle at 35% 30%, #fff9, transparent 40%), #ff8fb1;
        box-shadow: 0 4px 0 var(--ink);
        font: 800 1.5rem/1 var(--font-head);
        color: var(--ink);
        animation: jiggle .5s ease-in-out infinite alternate;
        animation-delay: calc(var(--i) * -.13s);
        transition: scale .3s var(--ease-bounce), background .3s;
        &:hover { scale: 1.1; }
        &[aria-pressed="true"] { scale: 1.2; box-shadow: 0 0 0 5px var(--sun), 0 4px 0 var(--ink); }
        &.he {
          background: radial-gradient(circle at 35% 30%, #fff9, transparent 40%), #ffd23f;
          animation: he-born .6s var(--ease-bounce), pulse 1.5s .6s ease-in-out infinite;
          box-shadow: 0 0 25px 6px #fff7c2;
          cursor: default;
        }
        &.gone { visibility: hidden; }
      }
      @keyframes jiggle { from { translate: -2px 1px; } to { translate: 2px -1px; } }
      @keyframes he-born { from { scale: 2; filter: brightness(3); } }
    }
  </style>
</fusion-game>
