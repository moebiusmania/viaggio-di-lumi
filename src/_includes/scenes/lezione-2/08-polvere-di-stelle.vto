<hot-spots>
  <div class="scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      {{ for s of [[40, 40], [360, 50], [50, 250], [350, 260], [110, 150], [300, 140]] }}
      <use href="#star" x="{{ s[0] - 10 }}" y="{{ s[1] - 10 }}" width="20" height="20" class="twinkle"/>
      {{ /for }}
      <g class="kid float-slow">
        <!-- a cheerful cartoon kid -->
        <path d="M168 150 L128 196 M232 150 L276 110" stroke="#2c1d11" stroke-width="18" stroke-linecap="round"/>
        <path d="M168 150 L128 196 M232 150 L276 110" stroke="#ffcf9e" stroke-width="11" stroke-linecap="round"/>
        <path d="M185 230 L178 285 M215 230 L222 285" stroke="#2c1d11" stroke-width="20" stroke-linecap="round"/>
        <path d="M185 230 L178 285 M215 230 L222 285" stroke="#4570b5" stroke-width="13" stroke-linecap="round"/>
        <path d="M165 140 Q200 125 235 140 L240 238 Q200 248 160 238 Z" fill="#dd6682" stroke="#2c1d11" stroke-width="5" stroke-linejoin="round"/>
        <use href="#star" x="186" y="170" width="28" height="28"/>
        <circle cx="200" cy="92" r="42" fill="#ffcf9e" stroke="#2c1d11" stroke-width="5"/>
        <path d="M160 86 Q165 44 205 48 Q240 50 242 84 Q222 64 196 70 Q176 74 160 86 Z" fill="#7a4a2a" stroke="#2c1d11" stroke-width="4" stroke-linejoin="round"/>
        <use href="#face" x="178" y="92" width="44" height="26"/>
      </g>
    </svg>
    <button class="spot" style="--x: 57%; --y: 32%" data-label="{{ spots[0].label |> escape }}" data-tip="{{ spots[0].tip |> md(true) |> escape }}"></button>
    <button class="spot" style="--x: 45%; --y: 91%" data-label="{{ spots[1].label |> escape }}" data-tip="{{ spots[1].tip |> md(true) |> escape }}"></button>
    <button class="spot" style="--x: 32%; --y: 63%" data-label="{{ spots[2].label |> escape }}" data-tip="{{ spots[2].tip |> md(true) |> escape }}"></button>
    <button class="spot" style="--x: 43%; --y: 50%" data-label="{{ spots[3].label |> escape }}" data-tip="{{ spots[3].tip |> md(true) |> escape }}"></button>
    <button class="spot" style="--x: 67%; --y: 36%" data-label="{{ spots[4].label |> escape }}" data-tip="{{ spots[4].tip |> md(true) |> escape }}"></button>
  </div>
  <output class="caption"></output>
</hot-spots>
