<tap-scene need="6">
  <div class="scene volcano-scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <rect class="air" x="0" y="0" width="400" height="300"/>
      <g class="gas-clouds">
        {{ for c of [[70, 60], [200, 40], [320, 70], [130, 100], [270, 110]] }}
        <g><circle cx="{{ c[0] }}" cy="{{ c[1] }}" r="26" fill="#d7d3e6"/><circle cx="{{ c[0] + 22 }}" cy="{{ c[1] + 6 }}" r="20" fill="#d7d3e6"/><circle cx="{{ c[0] - 22 }}" cy="{{ c[1] + 8 }}" r="18" fill="#d7d3e6"/></g>
        {{ /for }}
      </g>
      <path d="M0 250 Q100 235 200 248 T400 245 V300 H0 Z" fill="#4a3a38" stroke="#1d1846" stroke-width="4"/>
      <path d="M40 270 q30 -8 60 0 M230 280 q40 -10 80 0" stroke="#ff7a3d" stroke-width="5" fill="none" stroke-linecap="round"/>
      {{ for v of [[80, 1.0], [205, 1.3], [325, 0.9]] }}
      <g class="volcano" data-hit data-sound="boom" aria-label="{{ volcano |> escape }}" style="--x: {{ v[0] }}px">
        <g transform="translate({{ v[0] }} 250) scale({{ v[1] }})">
          <rect x="-60" y="-135" width="120" height="135" fill="transparent"/>
          <g class="burst">
            <circle cx="0" cy="-80" r="16" fill="#ff8a3d"/>
            <circle cx="-14" cy="-95" r="10" fill="#ffd23f"/>
            <circle cx="14" cy="-100" r="12" fill="#ff5d3d"/>
            <circle cx="0" cy="-120" r="20" fill="#bdb6c9"/>
          </g>
          <path d="M-55 0 L-14 -70 H14 L55 0 Z" fill="#7a5a44" stroke="#1d1846" stroke-width="5" stroke-linejoin="round"/>
          <path d="M-14 -70 H14 L10 -58 Q0 -50 -10 -58 Z" fill="#ff7a3d" stroke="#1d1846" stroke-width="3" stroke-linejoin="round"/>
          <path d="M-8 -60 q-6 20 -16 36 M8 -60 q4 16 12 30" stroke="#ff7a3d" stroke-width="5" fill="none" stroke-linecap="round"/>
        </g>
      </g>
      {{ /for }}
    </svg>
  </div>
  <p class="counter-pill"></p>
  <style>
    @scope {
      .volcano-scene::before { display: none; }
      .air { fill: color-mix(in oklch, #1b1446, #b0785a calc(var(--p) * 80%)); transition: fill .8s; }
      .gas-clouds g { opacity: 0; transition: opacity .8s, translate .8s; translate: 0 30px; }
      {{ for i of [1, 2, 3, 4, 5] }}:scope[data-count="{{ i }}"] .gas-clouds g:nth-child(-n + {{ i }}), {{ /for }}
      :scope[data-count="6"] .gas-clouds g { opacity: .9; translate: 0 0; }
      .volcano { cursor: pointer; &:hover > g { filter: brightness(1.15); } }
      .burst { opacity: 0; }
      .volcano.go .burst { animation: erupt 1.2s ease-out; }
      .volcano.go > g { animation: rumble .4s; }
      @keyframes erupt { 0% { opacity: 1; translate: 0 30px; scale: .3; } 60% { opacity: 1; } 100% { opacity: 0; translate: 0 -40px; scale: 1.5; } }
      @keyframes rumble { 25%, 75% { translate: 3px 0; } 50% { translate: -3px 0; } }
    }
  </style>
</tap-scene>
