<order-game>
  <div class="pool">
    <button class="chip" data-i="0">{{ chips[0].name }}</button>
    <button class="chip" data-i="1">{{ chips[1].name }}</button>
    <button class="chip" data-i="2">{{ chips[2].name }}</button>
    <button class="chip" data-i="3">{{ chips[3].name }}</button>
    <button class="chip" data-i="4">{{ chips[4].name }}</button>
    <button class="chip" data-i="5">{{ chips[5].name }}</button>
    <button class="chip" data-i="6">{{ chips[6].name }}</button>
    <button class="chip" data-i="7">{{ chips[7].name }}</button>
    <button class="chip" data-i="8">{{ chips[8].name }}</button>
  </div>
  <ol class="slots"></ol>
  <output class="caption">{{ caption }}</output>
</order-game>
