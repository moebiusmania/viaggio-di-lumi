<scene-slider data-steps="{{ steps |> JSON.stringify |> escape }}">
  <div class="scene rain-scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <rect class="sky-bg" width="400" height="300"/>
      <g class="rain">
        {{ for r of [[30, 0], [70, .3], [110, .1], [150, .5], [190, .2], [230, .6], [270, .15], [310, .45], [350, .25], [390, .55], [50, .7], [130, .8], [210, .9], [290, .75], [370, .85]] }}
        <path d="M{{ r[0] }} 80 l-6 18" stroke="#93c3d9" stroke-width="4" stroke-linecap="round" style="animation-delay: -{{ r[1] }}s"/>
        {{ /for }}
      </g>
      <g class="clouds">
        {{ for c of [[60, 50], [170, 40], [290, 55], [370, 35]] }}
        <g><circle cx="{{ c[0] }}" cy="{{ c[1] }}" r="30"/><circle cx="{{ c[0] + 28 }}" cy="{{ c[1] + 8 }}" r="24"/><circle cx="{{ c[0] - 28 }}" cy="{{ c[1] + 10 }}" r="22"/></g>
        {{ /for }}
      </g>
      <path class="ground" d="M0 210 Q60 190 110 230 Q170 270 230 235 Q290 200 340 225 Q380 240 400 215 V300 H0 Z" stroke="#2c1d11" stroke-width="4"/>
      <rect class="ocean" x="0" y="215" width="400" height="90" fill="#4a8fc0"/>
      <path class="ground-top" d="M0 250 Q40 244 60 262 V300 H0 Z M330 262 Q370 240 400 250 V300 H330 Z" fill="#6f5446" stroke="#2c1d11" stroke-width="4"/>
      <g class="thermo">
        <rect x="14" y="20" width="18" height="120" rx="9" fill="#fff" stroke="#2c1d11" stroke-width="3"/>
        <rect class="mercury" x="19" y="25" width="8" height="110" rx="4" fill="#cb5136"/>
        <circle cx="23" cy="148" r="13" fill="#cb5136" stroke="#2c1d11" stroke-width="3"/>
      </g>
    </svg>
  </div>
  <label class="slider"><span>{{ slider.from }}</span><input type="range" min="0" max="100" value="0" aria-label="{{ slider.label |> escape }}"><span>{{ slider.to }}</span></label>
  <output class="caption"></output>
  <style>
    @scope {
      .rain-scene::before { display: none; }
      .sky-bg { fill: color-mix(in oklch, #b0785a, #5b6c9a calc(var(--t) * 100%)); }
      .clouds g { fill: color-mix(in oklch, #f2e6dc, #8e97b8 calc(var(--t) * 100%)); animation: float 5s ease-in-out infinite; }
      .clouds g:nth-child(2n) { animation-delay: -2s; }
      .rain { opacity: clamp(0, var(--t) * 4 - 1.6, 1); }
      .rain path { animation: fall .7s linear infinite; }
      @keyframes fall { from { translate: 0 0; opacity: 1; } to { translate: -30px 110px; opacity: .2; } }
      .ground { fill: color-mix(in oklch, #d9713c, #6f5446 calc(clamp(0, var(--t) * 2, 1) * 100%)); }
      .ocean { scale: 1 clamp(0, var(--t) * 2.5 - 1.4, 1); transform-origin: bottom !important; }
      .mercury { scale: 1 calc(1 - var(--t) * .8); transform-origin: bottom !important; }
    }
  </style>
</scene-slider>
