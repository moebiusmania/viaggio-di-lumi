{{# The quiz at the end of every lesson. Texts: `quiz` in the page's .md (answer counts from 1) #}}
<quiz-set lesson="{{ lesson }}">
  {{ for q of quiz }}
  <quiz-q answer="{{ q.answer - 1 }}">
    <p class="q">{{ q.question |> md(true) }}</p>
    <div class="opts">{{ for o of q.options }}<button>{{ o |> md(true) }}</button>{{ /for }}</div>
    <p class="why">{{ q.why |> md(true) }}</p>
  </quiz-q>
  {{ /for }}
  {{ include "partials/medal.vto" }}
</quiz-set>
