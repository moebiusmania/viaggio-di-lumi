<nucleus-builder>
  <div class="scene">
    <div class="nucleus" aria-live="polite"></div>
  </div>
  <ul class="goals">
    {{ for g of goals }}
    <li data-goal="{{ g.protons }}-{{ g.neutrons }}">{{ g.name }} <small>{{ g.note }}</small></li>
    {{ /for }}
  </ul>
  <div class="btn-row">
    <button class="btn pink" type="button" data-add="p">{{ buttons.proton }}</button>
    <button class="btn paper" type="button" data-add="n">{{ buttons.neutron }}</button>
    <button class="btn sky" type="button" data-add="reset">{{ buttons.restart }}</button>
  </div>
  <output class="caption"></output>
  {{ for x of nuclei }}
  <template data-nucleus="{{ x.protons }}-{{ x.neutrons }}"><b>{{ x.name }}</b> {{ x.text |> md(true) }}</template>
  {{ /for }}
  <style>
    @scope {
      .scene { display: grid; place-items: center; }
      .nucleus {
        position: relative;
        width: 11rem;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 3px dashed oklch(100% 0 0 / .35);
        transition: box-shadow .5s;
      }
      :scope[data-p="1"][data-n="0"] .nucleus,
      :scope[data-p="2"][data-n="2"] .nucleus { box-shadow: 0 0 60px 10px oklch(88% 0.17 92 / .55); border-color: var(--sun); }
      .nucleon {
        --pos: -1.5rem -1.5rem;
        position: absolute;
        left: 50%;
        top: 50%;
        width: 4rem;
        aspect-ratio: 1;
        margin: -2rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: 4px solid var(--ink);
        font: 900 2rem/1 var(--font-head);
        color: var(--ink);
        translate: var(--pos);
        animation: drop-in .6s var(--ease-bounce) both;
        &.p { background: radial-gradient(circle at 35% 30%, #fff8, transparent 40%), #ff8fb1; }
        &.n { background: radial-gradient(circle at 35% 30%, #fff8, transparent 40%), #d7d3e6; }
        &:nth-child(1) { --pos: 0 0; z-index: 2; }
        &:nth-child(2) { --pos: 1.9rem -.6rem; }
        &:nth-child(3) { --pos: -1.1rem 1.7rem; z-index: 3; }
        &:nth-child(4) { --pos: .6rem -2rem; z-index: 1; }
      }
      .nucleus:has(.nucleon:nth-child(2)) .nucleon:nth-child(1) { --pos: -1.3rem -.4rem; }
      @keyframes drop-in { from { translate: 0 -12rem; scale: .5; } }
      .goals {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .6rem;
        & li {
          padding: .4rem 1rem;
          border: 3px solid var(--ink);
          border-radius: 99px;
          background: #fff;
          font-family: var(--font-head);
          &::before { content: "⬜ "; }
          &.got { background: var(--mint); animation: placed .5s var(--ease-bounce); &::before { content: "✅ "; } }
          & small { font-family: var(--font-body); font-size: .8rem; }
        }
      }
    }
  </style>
</nucleus-builder>
