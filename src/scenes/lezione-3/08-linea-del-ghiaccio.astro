---
const { bins, caption, chips } = Astro.props;
---
<sort-game>
  <div class="pool">
    <button class="chip" data-bin="rocciosi" data-why={chips[0].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="22" fill="#b5aca3" stroke="#2c1d11" stroke-width="5"/></svg> {chips[0].name}</button>
    <button class="chip" data-bin="rocciosi" data-why={chips[1].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="32" fill="#f2c57c" stroke="#2c1d11" stroke-width="5"/></svg> {chips[1].name}</button>
    <button class="chip" data-bin="rocciosi" data-why={chips[2].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><use href="#earth" x="-34" y="-34" width="68" height="68"/></svg> {chips[2].name}</button>
    <button class="chip" data-bin="rocciosi" data-why={chips[3].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="26" fill="#e0663a" stroke="#2c1d11" stroke-width="5"/></svg> {chips[3].name}</button>
    <button class="chip" data-bin="giganti" data-why={chips[4].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="44" fill="#e8b27d" stroke="#2c1d11" stroke-width="5"/><path d="M-40 -14 h80 M-42 6 h84 M-34 24 h68" stroke="#c0763f" stroke-width="7"/><ellipse cx="14" cy="14" rx="9" ry="6" fill="#c0463f"/></svg> {chips[4].name}</button>
    <button class="chip" data-bin="giganti" data-why={chips[5].why}><svg viewBox="-60 -40 120 80" aria-hidden="true"><use href="#ringed" x="-60" y="-40" width="120" height="80"/></svg> {chips[5].name}</button>
    <button class="chip" data-bin="giganti" data-why={chips[6].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="36" fill="#9fe3f0" stroke="#2c1d11" stroke-width="5"/></svg> {chips[6].name}</button>
    <button class="chip" data-bin="giganti" data-why={chips[7].why}><svg viewBox="-50 -50 100 100" aria-hidden="true"><circle r="35" fill="#4570b5" stroke="#2c1d11" stroke-width="5"/></svg> {chips[7].name}</button>
  </div>
  <div class="bins">
    <div class="bin" data-bin="rocciosi" style="--c: var(--orange)"><h3>{bins[0].name}<small>{bins[0].note}</small></h3><div class="bin-items"></div></div>
    <div class="bin" data-bin="giganti" style="--c: var(--sky)"><h3>{bins[1].name}<small>{bins[1].note}</small></h3><div class="bin-items"></div></div>
  </div>
  <output class="caption">{caption}</output>
  <style is:inline>
    @scope {
      .chip svg { background: var(--space-1); border-radius: .6rem; }
    }
  </style>
</sort-game>
