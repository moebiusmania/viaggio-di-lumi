---
import { md } from "../../lib/text";
const { spots } = Astro.props;
---
<hot-spots>
  <div class="scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <ellipse cx="200" cy="150" rx="190" ry="140" fill="#b28cff" opacity=".12"/>
      <g class="mw">
        <path d="M214 150 L218 152 L222 154 L225 157 L227 161 L228 165 L229 170 L229 175 L227 180 L224 185 L220 190 L215 195 L208 199 L201 202 L192 205 L183 207 L173 208 L162 208 L151 207 L140 204 L129 201 L119 195 L109 189 L99 181 L91 173 L85 163 L79 152 L76 140 L74 128 L75 116 L77 103 L82 90 L89 77 L98 65" fill="none" stroke="#c9b5ff" stroke-width="22" stroke-linecap="round" opacity=".55"/>
        <path d="M214 150 L218 152 L222 154 L225 157 L227 161 L228 165 L229 170 L229 175 L227 180 L224 185 L220 190 L215 195 L208 199 L201 202 L192 205 L183 207 L173 208 L162 208 L151 207 L140 204 L129 201 L119 195 L109 189 L99 181 L91 173 L85 163 L79 152 L76 140 L74 128 L75 116 L77 103 L82 90 L89 77 L98 65" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".75"/>
        <path d="M186 150 L182 148 L178 146 L175 143 L173 139 L172 135 L171 130 L171 125 L173 120 L176 115 L180 110 L185 105 L192 101 L199 98 L208 95 L217 93 L227 92 L238 92 L249 93 L260 96 L271 99 L281 105 L291 111 L301 119 L309 127 L315 137 L321 148 L324 160 L326 172 L325 184 L323 197 L318 210 L311 223 L302 235" fill="none" stroke="#c9b5ff" stroke-width="22" stroke-linecap="round" opacity=".55"/>
        <path d="M186 150 L182 148 L178 146 L175 143 L173 139 L172 135 L171 130 L171 125 L173 120 L176 115 L180 110 L185 105 L192 101 L199 98 L208 95 L217 93 L227 92 L238 92 L249 93 L260 96 L271 99 L281 105 L291 111 L301 119 L309 127 L315 137 L321 148 L324 160 L326 172 L325 184 L323 197 L318 210 L311 223 L302 235" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".75"/>
        <circle cx="200" cy="150" r="34" fill="#fff3a3" opacity=".9"/>
        <circle cx="200" cy="150" r="8" fill="#1d1846"/>
      </g>
    </svg>
    <button class="spot" style="--x: 50%; --y: 50%" data-label={spots[0].label} data-tip={md(spots[0].tip)}></button>
    <button class="spot" style="--x: 68%; --y: 33%" data-label={spots[1].label} data-tip={md(spots[1].tip)}></button>
    <button class="spot" style="--x: 20%; --y: 45%" data-label={spots[2].label} data-tip={md(spots[2].tip)}></button>
    <button class="spot" style="--x: 90%; --y: 12%" data-label={spots[3].label} data-tip={md(spots[3].tip)}></button>
  </div>
  <output class="caption"></output>
  <style is:inline>
    @scope {
      .mw > circle:first-of-type { animation: pulse 3s ease-in-out infinite; }
    }
  </style>
</hot-spots>
