---
const { bins, caption, chips } = Astro.props;
---
<sort-game>
  <div class="pool">
    <button class="chip" data-bin="spirale" data-why={chips[0].why}>
      <svg viewBox="-50 -50 100 100" aria-hidden="true"><use href="#galaxy" x="-50" y="-50" width="100" height="100"/></svg> {chips[0].name}
    </button>
    <button class="chip" data-bin="spirale" data-why={chips[1].why}>
      <svg viewBox="-50 -50 100 100" aria-hidden="true"><use href="#galaxy" x="-50" y="-50" width="100" height="100" transform="rotate(70) scale(1 .7)"/></svg> {chips[1].name}
    </button>
    <button class="chip" data-bin="ellittica" data-why={chips[2].why}>
      <svg viewBox="-50 -50 100 100" aria-hidden="true"><ellipse rx="44" ry="30" fill="#ffd9a8" opacity=".5"/><ellipse rx="30" ry="20" fill="#ffe7c2"/><ellipse rx="12" ry="8" fill="#fff"/></svg> {chips[2].name}
    </button>
    <button class="chip" data-bin="ellittica" data-why={chips[3].why}>
      <svg viewBox="-50 -50 100 100" aria-hidden="true"><ellipse rx="40" ry="38" fill="#ffc2d4" opacity=".5"/><ellipse rx="26" ry="24" fill="#ffd6e2"/><circle r="10" fill="#fff"/></svg> {chips[3].name}
    </button>
    <button class="chip" data-bin="irregolare" data-why={chips[4].why}>
      <svg viewBox="-50 -50 100 100" aria-hidden="true"><path d="M-40 -6 Q-30 -34 -4 -26 Q14 -40 32 -18 Q46 4 26 18 Q10 40 -12 28 Q-42 26 -40 -6 Z" fill="#b8f0d8" opacity=".7"/><circle cx="-12" cy="-6" r="7" fill="#fff"/><circle cx="14" cy="6" r="5" fill="#fff"/></svg> {chips[4].name}
    </button>
    <button class="chip" data-bin="irregolare" data-why={chips[5].why}>
      <svg viewBox="-50 -50 100 100" aria-hidden="true"><path d="M-30 10 Q-40 -20 -10 -20 Q0 -40 20 -24 Q40 -10 24 14 Q10 34 -14 26 Z" fill="#c9d0ff" opacity=".8"/><circle cx="4" cy="-4" r="7" fill="#fff"/></svg> {chips[5].name}
    </button>
  </div>
  <div class="bins">
    <div class="bin" data-bin="spirale" style="--c: var(--purple)"><h3>{bins[0].name}<small>{bins[0].note}</small></h3><div class="bin-items"></div></div>
    <div class="bin" data-bin="ellittica" style="--c: var(--orange)"><h3>{bins[1].name}<small>{bins[1].note}</small></h3><div class="bin-items"></div></div>
    <div class="bin" data-bin="irregolare" style="--c: var(--mint)"><h3>{bins[2].name}<small>{bins[2].note}</small></h3><div class="bin-items"></div></div>
  </div>
  <output class="caption">{caption}</output>
  <style is:inline>
    @scope {
      .chip svg { background: var(--space-1); border-radius: .6rem; padding: 2px; }
    }
  </style>
</sort-game>
