---
const { canvas, slider } = Astro.props;
---
<space-canvas mode="soup">
  <div class="scene"><canvas aria-label={canvas}></canvas></div>
  <label class="slider"><span>{slider.from}</span><input type="range" min="0" max="100" value="100" data-param="temp" aria-label={slider.label}><span>{slider.to}</span></label>
  <output class="caption"></output>
</space-canvas>
