---
const { slider, steps } = Astro.props;
---
<scene-slider data-steps={JSON.stringify(steps)}>
  <div class="scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <circle class="heat" cx="200" cy="150" r="120" fill="url(#heat-1)"/>
      <defs>
        <radialGradient id="heat-1"><stop offset="0" stop-color="#fff3a3"/><stop offset=".4" stop-color="#ff9f43" stop-opacity=".7"/><stop offset="1" stop-color="#ff5d8f" stop-opacity="0"/></radialGradient>
      </defs>
      <g class="thing" style="--dx:-115; --dy:-75"><use href="#galaxy" x="170" y="120" width="60" height="60" class="spin"/></g>
      <g class="thing" style="--dx:120; --dy:70"><use href="#galaxy" x="175" y="125" width="50" height="50" class="spin-back"/></g>
      <g class="thing" style="--dx:115; --dy:-75"><use href="#sun" x="172" y="122" width="56" height="56"/></g>
      <g class="thing" style="--dx:-120; --dy:80"><use href="#earth" x="178" y="128" width="44" height="44"/></g>
      <g class="thing" style="--dx:10; --dy:95"><use href="#ringed" x="170" y="135" width="60" height="30"/></g>
      <g class="thing" style="--dx:-10; --dy:-100"><use href="#moon" x="185" y="135" width="30" height="30"/></g>
      {([[-170, 0], [165, 0], [-60, -115], [60, 110], [-70, 30], [70, -30], [175, 120], [-175, -120]]).map((s) => (<>
      <g class="thing" style={`--dx:${s[0]}; --dy:${s[1]}`}><use href="#star" x="189" y="139" width="22" height="22" class="twinkle"/></g>
      </>))}
      <circle class="dot" cx="200" cy="150" r="10" fill="#fff"/>
    </svg>
  </div>
  <label class="slider"><span>{slider.from}</span><input type="range" min="0" max="100" value="0" aria-label={slider.label}><span>{slider.to}</span></label>
  <output class="caption"></output>
  <style is:inline>
    @scope {
      .thing {
        translate: calc(var(--dx) * (1 - var(--t)) * 1px) calc(var(--dy) * (1 - var(--t)) * 1px);
        scale: calc(1 - var(--t) * .85);
        opacity: calc(1.3 - var(--t) * 1.3);
      }
      .heat { scale: calc(var(--t) * 1.2); opacity: var(--t); }
      .dot { scale: calc(.2 + var(--t)); opacity: calc(var(--t) * 2 - 1); filter: drop-shadow(0 0 8px #fff); }
      .scene { background-color: color-mix(in oklch, var(--space-1), #ff7a3d calc(var(--t) * 35%)); }
      .slider { flex-wrap: wrap; justify-content: center; }
    }
  </style>
</scene-slider>
