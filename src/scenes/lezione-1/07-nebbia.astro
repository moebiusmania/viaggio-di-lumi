---
const { slider, steps } = Astro.props;
---
<scene-slider data-steps={JSON.stringify(steps)}>
  <div class="scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <g class="rays">
        {([60, 130, 200, 260]).map((y) => (<>
        <path d={`M-10 ${y} H410`} stroke="#f2cf63" stroke-width="5" stroke-linecap="round" stroke-dasharray="26 18"/>
        </>))}
      </g>
      <g class="atoms">
        {([[90, 95], [210, 165], [320, 90], [120, 225], [310, 230]]).map((a) => (<>
        <g>
          <ellipse cx={a[0]} cy={a[1]} rx="34" ry="14" fill="none" stroke="#9fd8ff" stroke-width="2.5" transform={`rotate(-25 ${a[0]} ${a[1]})`}/>
          <circle cx={a[0]} cy={a[1]} r="11" fill="#e495a8" stroke="#2c1d11" stroke-width="3"/>
          <circle class="electron spin-fast" cx={a[0] + 31} cy={a[1] - 14} r="5" fill="#f2cf63" stroke="#2c1d11" stroke-width="2" style={`transform-box: view-box; transform-origin: ${a[0]}px ${a[1]}px`}/>
        </g>
        </>))}
      </g>
      <g class="free">
        {([[40, 40], [150, 60], [260, 40], [360, 150], [80, 170], [190, 110], [250, 250], [40, 270], [340, 280], [160, 280], [290, 140], [120, 130]]).map((e) => (<>
        <circle cx={e[0]} cy={e[1]} r="5" fill="#f2cf63" class="wiggle" style="animation-duration: .4s"/>
        </>))}
        <path class="zig" d="M20 150 L70 60 L120 180 L150 90 L200 230 L240 70 L290 200 L330 110 L380 190" fill="none" stroke="#f6e6a6" stroke-width="4" stroke-linejoin="round" stroke-dasharray="14 10"/>
      </g>
      <g class="fog">
        {([[80, 80, 90], [260, 70, 100], [180, 190, 120], [340, 230, 90], [60, 240, 80]]).map((f) => (<>
        <circle cx={f[0]} cy={f[1]} r={f[2]} fill="#fff4e0"/>
        </>))}
      </g>
    </svg>
  </div>
  <label class="slider"><span>{slider.from}</span><input type="range" min="0" max="100" value="0" aria-label={slider.label}><span>{slider.to}</span></label>
  <output class="caption"></output>
  <style is:inline>
    @scope {
      .fog { opacity: calc((1 - var(--t) * 1.3) * .75); filter: blur(22px); }
      .free { opacity: calc(1 - var(--t) * 1.8); }
      .zig { animation: dash .8s linear infinite; }
      .atoms { opacity: calc(var(--t) * 2.2 - 1); }
      .rays { opacity: calc(var(--t) * 3 - 2); & path { animation: dash .7s linear infinite; } }
      .scene { background-color: color-mix(in oklch, #e9a86b calc((1 - var(--t)) * 70%), var(--space-1)); }
      @keyframes dash { to { stroke-dashoffset: -44; } }
    }
  </style>
</scene-slider>
