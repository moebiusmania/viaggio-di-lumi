---
const { button, canvas, caption } = Astro.props;
---
<space-canvas mode="bang">
  <div class="scene"><canvas aria-label={canvas}></canvas></div>
  <div class="btn-row"><button class="btn big pink" type="button" data-action="bang">{button}</button></div>
  <output class="caption">{caption}</output>
</space-canvas>
