---
import { md } from "../../lib/text";
const { cards } = Astro.props;
---
<div class="cards">
  <flip-card style="--c: var(--pink)">
    <div class="face front">
      <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="52" r="26" fill="#c9534f" stroke="#2c1d11" stroke-width="4"/><use href="#face" x="32" y="46" width="36" height="20"/></svg>
      {cards[0].front}
    </div>
    <div class="face back">
      <b>{cards[0].title}</b>
      <p><Fragment set:html={md(cards[0].text)} /></p>
    </div>
  </flip-card>
  <flip-card style="--c: var(--sun)">
    <div class="face front">
      <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="40" fill="#ecb7bf" stroke="#2c1d11" stroke-width="4"/><circle cx="36" cy="38" r="10" fill="#c9534f" stroke="#2c1d11" stroke-width="3"/><circle cx="64" cy="38" r="10" fill="#62a97c" stroke="#2c1d11" stroke-width="3"/><circle cx="50" cy="64" r="10" fill="#4a86bf" stroke="#2c1d11" stroke-width="3"/><text x="82" y="24" font-size="26" font-weight="900" fill="#2c1d11">+</text></svg>
      {cards[1].front}
    </div>
    <div class="face back">
      <b>{cards[1].title}</b>
      <p><Fragment set:html={md(cards[1].text)} /></p>
    </div>
  </flip-card>
  <flip-card style="--c: var(--mint)">
    <div class="face front">
      <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="40" fill="#d3cfd9" stroke="#2c1d11" stroke-width="4"/><circle cx="36" cy="38" r="10" fill="#c9534f" stroke="#2c1d11" stroke-width="3"/><circle cx="64" cy="38" r="10" fill="#62a97c" stroke="#2c1d11" stroke-width="3"/><circle cx="50" cy="64" r="10" fill="#4a86bf" stroke="#2c1d11" stroke-width="3"/></svg>
      {cards[2].front}
    </div>
    <div class="face back">
      <b>{cards[2].title}</b>
      <p><Fragment set:html={md(cards[2].text)} /></p>
    </div>
  </flip-card>
  <flip-card style="--c: var(--sky)">
    <div class="face front">
      <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M14 40 h22 M8 52 h26 M14 64 h22" stroke="#2c1d11" stroke-width="4" stroke-linecap="round"/><circle cx="62" cy="52" r="18" fill="#f2cf63" stroke="#2c1d11" stroke-width="4"/><text x="80" y="30" font-size="30" font-weight="900" fill="#2c1d11">–</text></svg>
      {cards[3].front}
    </div>
    <div class="face back">
      <b>{cards[3].title}</b>
      <p><Fragment set:html={md(cards[3].text)} /></p>
    </div>
  </flip-card>
</div>
