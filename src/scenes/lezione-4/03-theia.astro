---
const { button } = Astro.props;
---
<anim-trigger target="#theia-scene" done-ms="3000" data-again-text={button.again}>
  <div class="scene" id="theia-scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <g class="earth-b">
        <circle cx="240" cy="150" r="70" fill="#ff7a3d" stroke="#1d1846" stroke-width="5"/>
        <path d="M200 120 q20 10 40 -4 M250 180 q20 -10 30 8 M215 170 q10 6 20 0" fill="none" stroke="#ffe066" stroke-width="4" stroke-linecap="round"/>
        <use class="calm" href="#face" x="212" y="146" width="56" height="34"/>
      </g>
      <g class="theia">
        <circle cx="40" cy="60" r="36" fill="#b28cff" stroke="#1d1846" stroke-width="5"/>
        <use href="#face" x="24" y="54" width="32" height="20"/>
      </g>
      <circle class="boom" cx="185" cy="115" r="30" fill="#fff7c2"/>
      <g class="debris">
        {([[-120, -60], [-90, 70], [-40, -110], [60, -120], [130, -40], [120, 80], [20, 120], [-130, 10], [90, 110], [-70, -100]]).map((d) => (<>
        <circle cx="240" cy="150" r={5 + (d[0] > 0 ? 3 : 1)} fill="#a8927e" stroke="#1d1846" stroke-width="2" style={`--dx: ${d[0]}px; --dy: ${d[1]}px`}/>
        </>))}
      </g>
    </svg>
  </div>
  <div class="btn-row"><button class="btn big pink" type="button">{button.go}</button></div>
  <style is:inline>
    @scope {
      :scope { display: flex; flex-direction: column; gap: 1rem; }
      .boom, .debris circle { opacity: 0; }
      .run .theia { animation: theia-fly 1.1s ease-in forwards; }
      .run .boom { animation: boom-flash .9s 1s ease-out; }
      .run .earth-b { animation: earth-shake .6s 1.05s; }
      .run .debris circle { animation: fling 1.8s 1.05s var(--ease-out) forwards; }
      @keyframes theia-fly { 85% { translate: 150px 60px; scale: 1; opacity: 1; } 100% { translate: 170px 70px; scale: .2; opacity: 0; } }
      @keyframes boom-flash { from { opacity: 1; scale: .5; } to { opacity: 0; scale: 7; } }
      @keyframes earth-shake { 20%, 60% { translate: 8px 4px; } 40%, 80% { translate: -6px -3px; } }
      @keyframes fling { from { opacity: 1; translate: 0 0; } to { opacity: 1; translate: var(--dx) var(--dy); } }
    }
  </style>
</anim-trigger>
