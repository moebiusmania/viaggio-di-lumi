---
const { labels, slider, steps } = Astro.props;
---
<scene-slider data-steps={JSON.stringify(steps)}>
  <div class="scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <use href="#earth" x="30" y="100" width="100" height="100"/>
      <g class="ring">
        <ellipse cx="80" cy="150" rx="95" ry="30" fill="none" stroke="#a8927e" stroke-width="6" stroke-dasharray="4 10" opacity=".8"/>
      </g>
      {([[-40, -30], [30, 40], [-20, 45], [45, -20], [-45, 10], [15, -45], [35, 25], [-30, -45]]).map((d) => (<>
      <circle class="bit" cx="175" cy="150" r="7" fill="#c6c0cf" stroke="#2c1d11" stroke-width="2" style={`--dx: ${d[0]}; --dy: ${d[1]}`}/>
      </>))}
      <g class="moon">
        <use href="#moon" x="140" y="115" width="70" height="70"/>
      </g>
      <text class="label dist" x="250" y="280" text-anchor="middle" font-size="16">{labels.farther}</text>
    </svg>
  </div>
  <label class="slider"><span>{slider.from}</span><input type="range" min="0" max="100" value="0" aria-label={slider.label}><span>{slider.to}</span></label>
  <output class="caption"></output>
  <style is:inline>
    @scope {
      .ring { opacity: calc(1 - var(--t) * 2.5); }
      .bit {
        --k: clamp(0, var(--t) * 2.2, 1);
        translate: calc(var(--dx) * (1 - var(--k)) * 1px) calc(var(--dy) * (1 - var(--k)) * 1px);
        opacity: calc(1.2 - var(--t) * 2.2);
      }
      .moon {
        --far: clamp(0, var(--t) * 2 - 1, 1);
        opacity: clamp(0, var(--t) * 3 - .8, 1);
        translate: calc(var(--far) * 170px) 0;
        scale: calc(1.2 - var(--far) * .75);
        transform-origin: 175px 150px !important;
        transform-box: view-box !important;
      }
      .dist { opacity: calc(var(--t) * 3 - 2); }
    }
  </style>
</scene-slider>
