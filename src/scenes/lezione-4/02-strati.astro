---
const { labels, slider, steps } = Astro.props;
---
<scene-slider data-steps={JSON.stringify(steps)}>
  <div class="scene">
    <svg viewBox="0 0 400 300" aria-hidden="true">
      <g class="planet">
        <circle cx="140" cy="150" r="115" fill="#ff7a3d" stroke="#1d1846" stroke-width="5"/>
        <circle class="mantle" cx="140" cy="150" r="104" fill="#e8663a"/>
        <circle class="core" cx="140" cy="150" r="50" fill="#b9b3c2" stroke="#1d1846" stroke-width="4"/>
        <circle class="crust" cx="140" cy="150" r="111" fill="none" stroke="#7a5a44" stroke-width="10"/>
        {([[-70, -40], [60, -60], [-30, 70], [75, 40], [-85, 20], [20, -85], [40, 80], [-50, -75], [85, -20], [-10, 30]]).map((d) => (<>
        <circle class="iron" cx="140" cy="150" r="9" fill="#8f8a9b" stroke="#1d1846" stroke-width="2.5" style={`--dx: ${d[0]}; --dy: ${d[1]}`}/>
        </>))}
        <g class="labels">
          <text class="label" x="140" y="156" text-anchor="middle" font-size="15">{labels.core}</text>
          <text class="label" x="140" y="90" text-anchor="middle" font-size="15">{labels.mantle}</text>
          <text class="label" x="140" y="286" text-anchor="middle" font-size="15">{labels.crust}</text>
        </g>
      </g>
      <g class="peach">
        <circle cx="325" cy="150" r="58" fill="#ffb37a" stroke="#1d1846" stroke-width="5"/>
        <circle cx="325" cy="150" r="52" fill="#ffd7a1"/>
        <ellipse cx="325" cy="150" rx="22" ry="28" fill="#a0522d" stroke="#1d1846" stroke-width="4"/>
        <path d="M325 92 q10 -22 30 -18 q-8 16 -30 18 z" fill="#3ddc97" stroke="#1d1846" stroke-width="3"/>
        <text class="label" x="325" y="235" text-anchor="middle" font-size="16">{labels.peach}</text>
      </g>
    </svg>
  </div>
  <label class="slider"><span>{slider.from}</span><input type="range" min="0" max="100" value="0" aria-label={slider.label}><span>{slider.to}</span></label>
  <output class="caption"></output>
  <style is:inline>
    @scope {
      .iron { translate: calc(var(--dx) * (1 - var(--t)) * 1px) calc(var(--dy) * (1 - var(--t)) * 1px); opacity: calc(1.6 - var(--t) * 1.6); }
      .core { scale: var(--t); opacity: calc(var(--t) * 2 - .4); }
      .mantle { opacity: calc(var(--t) * 1.5); }
      .crust { opacity: calc(var(--t) * 3 - 1.8); }
      .labels { opacity: calc(var(--t) * 4 - 3); }
      .peach { opacity: calc(var(--t) * 4 - 2.6); translate: calc((1 - var(--t)) * 40px) 0; }
    }
  </style>
</scene-slider>
